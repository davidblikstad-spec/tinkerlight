[Unit]
Description=Tinkerlight DMX controller
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=tinkerlight
Group=tinkerlight
SupplementaryGroups=dialout video
WorkingDirectory=/opt/tinkerlight
Environment=TINKERLIGHT_DATA=/var/lib/tinkerlight
Environment=TINKERLIGHT_PORT=80
ExecStart=/usr/bin/python3 -m tinkerlight
# lets the unprivileged user bind port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2
Nice=-5
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/tinkerlight

[Install]
WantedBy=multi-user.target
